# Patterns are Perl regex matched against the package-root-relative path of
# each candidate file. Anything that matches is dropped from the source tarball
# produced by `R CMD build` (and therefore from any install). Keep this list
# tight: only R/, man/, data/ (sans data/tcga), tests/, inst/shiny/, the root
# DESCRIPTION/NAMESPACE/LICENSE/README, and the .Rbuildignore itself should
# ship.

# -- editor / VCS / IDE state -------------------------------------------------
^PhenoMapR\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.DS_Store$
^\.cursor$
^\.github$
^\.gitattributes$
^\.gitignore$
^.*~$

# -- pkgdown / docs / vignette infrastructure ---------------------------------
^_pkgdown\.yml$
^docs$
^pkgdown$
^vignettes$
^doc$
^Meta$
^CITATION\.cff$

# -- raw / scratch / dev assets at repo root ----------------------------------
^data-raw$
^results$
^scripts$
^tools$
^library$
^bench_render_nohup\.sh$
^codecov\.yml$
^GITHUB_SETUP\.md$
^GOOGLE_DOCS_AND_ZOTERO_EXPORT\.md$
^\.tmp_scsurv_pkg$

# -- R CMD build / R CMD check leftovers --------------------------------------
^.*\.Rcheck$
^\.\.Rcheck$

# -- manuscript / legacy benchmark trees (not shipped with the package) -------
# Analyses and large artifacts live under manuscript/ (see manuscript/README.md).
# Keep ignoring legacy inst/benchmarks if anything remains there locally.
^inst/benchmarks$
^inst/benchmarking$
^manuscript$
^inst/extdata$
^inst/vignette-drafts$
^inst/figures$
^man/figures$
^data/tcga$

# -- raw / scratch data files dropped in the repo root ------------------------
# These are inputs/outputs for the benchmarking pipeline, not package data.
# Package data (PRECOG/TCGA/Pediatric/ICI z-score tables) lives in /data/*.rda
# and is unaffected by these patterns.
^FSHD_.*\.rds$
^GSE.*\.(rds|csv|tsv|h5)$
^PAAD_.*$
^HT.*\.rds$
^PRECOG_V2_.*\.rds$
^TCGA_metaz\.csv$
^ici_precog_.*\.rds$
^pediatric_metaZ\.xlsx$
^datasets_info_for_scoring\.rds$

# -- review / manuscript build artifacts --------------------------------------
^Review_.*$
